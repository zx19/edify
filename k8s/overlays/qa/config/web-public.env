# web 组件的浏览器侧 URL（以 behavior: merge 合并进 base 的 lomva-web-config）
# API 走 /lomva 子路径，由 overlay 的 nginx 配置剥离前缀后转发 api
CONSOLE_API_URL=https://qa-xai.xingshulin.com/lomva
APP_API_URL=https://qa-xai.xingshulin.com/lomva
# socket.io client 的 HTTP path 固定为 /socket.io（URL 中的子路径会被当作 namespace），
# 所以这里只能是根路径；Ingress 需同时把 /socket.io/ 路由到 nginx
NEXT_PUBLIC_SOCKET_URL=wss://qa-xai.xingshulin.com
# 与 web 镜像构建参数 NEXT_PUBLIC_BASE_PATH 保持一致
NEXT_PUBLIC_BASE_PATH=/lomva
