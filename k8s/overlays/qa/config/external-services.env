# QA 外部自建 PostgreSQL（独立域名）；部署前必须改为实际值
# 需先建好 lomva / lomva_plugin 两个库，并在 lomva 库内 CREATE EXTENSION IF NOT EXISTS "uuid-ossp"
DB_HOST=qa-postgres-default.xsl.link
DB_PORT=5432
DB_USERNAME=dev_svc_lomva
# 外部 PG 会掐空闲连接，池内死连接导致 flask-login 吞异常后误判 401（登录后 auth/refresh 死循环）
SQLALCHEMY_POOL_PRE_PING=true

# 飞书邮箱 SMTP（邀请成员/重置密码等邮件；实际发信在 worker 的 mail_send_task）
# 密码在 config/secret.env 的 SMTP_PASSWORD；465 为隐式 SSL（SMTP_SSL），不走 STARTTLS
MAIL_TYPE=smtp
MAIL_DEFAULT_SEND_FROM=tech01@xingshulin.com
SMTP_SERVER=smtp.feishu.cn
SMTP_PORT=465
SMTP_USERNAME=tech01@xingshulin.com
SMTP_USE_TLS=true
SMTP_OPPORTUNISTIC_TLS=false

# 工作区级品牌自定义（工作空间设置 → 自定义 tab：去除品牌/替换 WebApp Logo）
# 企业配置默认 False，社区版经 env 开启；生效后 WebApp 页脚品牌可用工作区 Logo
CAN_REPLACE_LOGO=true
