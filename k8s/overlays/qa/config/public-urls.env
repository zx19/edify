# 对外 URL（子路径部署于 https://qa-xai.xingshulin.com/lomva）
# 以 behavior: merge 合并进 base 的 lomva-config，只覆盖以下 key
# 注意：CONSOLE_API_URL 必须显式覆盖，否则 api 镜像默认 http://127.0.0.1:5001
# 会使 is_secure()=False，cookie 名不带 __Host- 前缀，与 web 侧读取的
# __Host-csrf_token 不一致，导致登录后 CSRF 401 死循环
CONSOLE_WEB_URL=https://qa-xai.xingshulin.com/lomva
CONSOLE_API_URL=https://qa-xai.xingshulin.com/lomva
SERVICE_API_URL=https://qa-xai.xingshulin.com/lomva
APP_WEB_URL=https://qa-xai.xingshulin.com/lomva
TRIGGER_URL=https://qa-xai.xingshulin.com/lomva
ENDPOINT_URL_TEMPLATE=https://qa-xai.xingshulin.com/lomva/e/{hook_id}
