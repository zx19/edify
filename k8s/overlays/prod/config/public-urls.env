# 线上对外 URL（部署前把 lomva.example.com 改为实际域名）
CONSOLE_WEB_URL=https://lomva.example.com/lomva
# 必须显式配置，否则 api 镜像默认 http://127.0.0.1:5001 使 is_secure()=False，
# cookie 名不带 __Host- 前缀，与 web 侧读取的不一致，登录后 CSRF 401 死循环
CONSOLE_API_URL=https://lomva.example.com/lomva
SERVICE_API_URL=https://lomva.example.com/lomva
# APP_WEB_URL 约定为 origin-only（web 侧自行拼 basePath，API 侧邮件链接自动补子路径）
APP_WEB_URL=https://lomva.example.com
TRIGGER_URL=https://lomva.example.com/lomva
ENDPOINT_URL_TEMPLATE=https://lomva.example.com/lomva/e/{hook_id}
