# 外部中间件地址（以 behavior: merge 合并进 base 的 lomva-config）
# 部署前必须改为实际值

# 外部 PostgreSQL（TencentDB 内网地址；需先建好 lomva / lomva_plugin 两个库，
# 并在 lomva 库内 CREATE EXTENSION IF NOT EXISTS "uuid-ossp"，步骤见 README）
DB_HOST=CHANGE_ME.postgres.tencentcdb.com
DB_PORT=5432

# 外部 PG 会掐空闲连接，池内死连接导致 flask-login 吞异常后误判 401
SQLALCHEMY_POOL_PRE_PING=true
