# 线上 web 组件的浏览器侧 URL（部署前把 lomva.example.com 改为实际域名）
CONSOLE_API_URL=https://lomva.example.com/lomva
APP_API_URL=https://lomva.example.com/lomva
# socket.io client 的 HTTP path 固定 /socket.io，URL 子路径会被当作 namespace，只能是根路径
NEXT_PUBLIC_SOCKET_URL=wss://lomva.example.com
# 与 web 镜像构建参数 NEXT_PUBLIC_BASE_PATH 保持一致
NEXT_PUBLIC_BASE_PATH=/lomva
